{
  "name": "Node.js + Python Dev Environment",

  // ベースイメージ（Ubuntu + 共通ツール）
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  // Dev Container Features で言語・ツールを追加
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22",
      "nodeGypDependencies": true
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12",
      "installTools": true
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest",
      "ppa": true
    }
  },

  // コンテナ作成後に一度だけ実行（Claude Code CLI + Codex CLI + pnpm）
  "postCreateCommand": "curl -fsSL https://claude.ai/install.sh | bash && npm install -g @openai/codex pnpm && echo 'Dev container ready!'",

  // Mac の設定をコンテナにマウント（個人設定・認証を引き継ぐ）
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.codex,target=/home/vscode/.codex,type=bind,consistency=cached"
  ],

  // VS Code 拡張機能（チーム共通）
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-python.python"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  },

  // コンテナ内のポートフォワーディング（開発サーバー用）
  "forwardPorts": [3000, 5173, 8000],

  // 非 root ユーザーで実行
  "remoteUser": "vscode"
}
